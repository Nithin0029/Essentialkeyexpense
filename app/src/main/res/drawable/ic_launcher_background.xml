<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background: a flat black field.

    Full-bleed on purpose. The launcher masks this layer to whatever shape it uses (circle,
    squircle, rounded square), so the visible silhouette is black regardless of device. All the
    detail lives in the foreground layer, inside the 72dp safe zone, where nothing can be cropped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
