<?xml version="1.0" encoding="utf-8"?>
<!--
    Both layers are vectors, so the icon stays sharp at every density and needs no per-dpi
    bitmaps. The monochrome layer reuses the foreground: on Android 13+ with themed icons the
    system draws that shape alone, tinted to the wallpaper palette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
